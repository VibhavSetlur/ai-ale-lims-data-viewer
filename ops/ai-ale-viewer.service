# systemd --user unit for the AI-ALE LIMS data viewer.
#
# Install (once):
#   mkdir -p ~/.config/systemd/user
#   cp ops/ai-ale-viewer.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now ai-ale-viewer
#
# Survive reboots (so nginx upstream is always reachable):
#   loginctl enable-linger vsetlur     # only needs to be run once
#
# Manage:
#   systemctl --user status  ai-ale-viewer
#   systemctl --user restart ai-ale-viewer
#   journalctl --user -u     ai-ale-viewer -f

[Unit]
Description=AI-ALE LIMS data viewer (Next.js on port 3457)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/scratch/vsetlur/ai-ale-lims-data-viewer
# Reuse the existing conda env so we don't double-install node.
# bash -lc is used so `conda activate` loads via the user's profile.
ExecStart=/bin/bash -lc 'source /scratch/vsetlur/anaconda3/etc/profile.d/conda.sh && conda activate ai-ale-dev && exec npm start -- -H 0.0.0.0 -p 3457'
Restart=on-failure
RestartSec=5s
# Bound the restart loop in case of a config bug — don't hammer the host.
StartLimitInterval=120
StartLimitBurst=5
# Send logs to journald so `journalctl --user -u ai-ale-viewer` works.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-ale-viewer

[Install]
WantedBy=default.target
