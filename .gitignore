# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database files (keep the mutation-explorer seed + example shipped)
data/*
!data/mutations.json
!data/mutations.example.csv
archive/

# local config overrides
/local/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
