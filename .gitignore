# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
server.log
ops/server.log
ops/server.log.*
ops/server.pid

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# pre-baked static data artifacts (generated by scripts/prebake.mjs, ~15MB)
/public/data/*.json
/public/data/*.json.gz
/public/data/manifest.json

# client-side SQLite for static build (generated by scripts/prepare-httpvfs-db.sh)
/public/db/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database files (keep the mutation-explorer seed + example shipped)
data/*
!data/mutations.json
!data/mutations.example.csv
archive/

# database artifacts anywhere in the tree (never commit DBs or dumps)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.dump

# local config overrides
/local/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.scratch/

# local-only notes (deploy recipe, archived meeting/audit notes) - not for publication
.local-notes/

# generated static-export artifacts (built per deploy, never committed)
/out/
public/db/
public/data/*.json
public/data/*.json.gz
public/data/manifest.json

# local live-refresh state
/ops/auto-refresh-live.log
/ops/auto-refresh-live.lock
/ops/live-db-source.mtime

# local agent rules and private writing handoffs (not for publication)
CLAUDE.md
AGENTS.md
GEMINI.md
/docs/MANUSCRIPT_INTEGRATION.md

# operator prompt shortcuts (session starters, not for publication)
docs/prompts/
