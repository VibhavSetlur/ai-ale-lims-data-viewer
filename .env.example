# Scientific data source (read-only authoritative mirror)
SQLITE_PATH=data/lims_mirror.backup.db
# MYSQL_URL=mysql://user:pass@host:3306/lims

# -----------------------------------------------------------------------
# Live ops slice (mutable operational plane: auth, sessions, workspaces,
# saved plate designs). Separate from the read-only scientific backend
# above. See docs/OPS_LIVE_RUNBOOK.md for full setup and safety notes.
#
# All lines below are commented out on purpose. Copy this file to a local
# untracked .env, fill in real values, and uncomment only what you need.
# Never commit real secrets. Never put them in this example file.
# -----------------------------------------------------------------------

# OPS_DB_URL: MySQL connection URL for the ops database ONLY.
# MUST be a different database (and different variable) from MYSQL_URL
# above. Never point OPS_DB_URL at the scientific database.
# OPS_DB_URL=mysql://ops_user:ops_pass@host:3306/lims_ops

# ORCID OAuth app credentials (register at orcid.org or sandbox.orcid.org)
# ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
# ORCID_CLIENT_SECRET=00000000-0000-0000-0000-000000000000

# ORCID_REDIRECT_URI: must exactly match the redirect URI registered in
# the ORCID developer application. Session cookie is Secure only when
# this starts with https://. For loopback-only testing:
# ORCID_REDIRECT_URI=http://127.0.0.1:3458/api/auth/orcid/callback

# ORCID_BASE: optional, defaults to https://orcid.org.
# Use https://sandbox.orcid.org for ORCID sandbox testing.
# ORCID_BASE=https://sandbox.orcid.org

# OPS_SESSION_PEPPER: required, minimum 32 characters, used to hash
# session tokens at rest. Generate a random value, do not reuse examples.
# OPS_SESSION_PEPPER=change-me-to-a-random-string-at-least-32-chars-long

# OPS_SESSION_TTL_HOURS: optional, defaults to 720 (30 days). Must be a
# positive number.
# OPS_SESSION_TTL_HOURS=720

# Viewer Argo assistant (talks to the local pass-through proxy on 3459,
# see docs/OPS_ARGO_PROXY.md). No Argo API key is ever stored in env,
# files, the database, or browser storage. The user supplies their own
# key per session and it is held in memory only.
# ASSISTANT_ENABLED=false
# ASSISTANT_PROXY_URL=http://127.0.0.1:3459
# ASSISTANT_MODEL=gpt5mini
# ASSISTANT_TIMEOUT_MS=300000
